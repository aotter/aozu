  "directions": [
    {
      "id": "origin-travel",
      "name": "AOZU 人物創建任務",
      "summary": "告訴夥伴三個想去的地方，完成行程後取得遠航造型與可再次召回的旅程策劃能力。",
      "seed": {
        "kind": "task",
        "directionId": "origin-travel",
        "loopIds": [
          "bond",
          "journey",
          "mastery"
        ],
        "completionMode": "finite",
        "brief": "以 WebMCP 引導使用者建立布丁獺，收集三個旅行地點，整理為可執行行程，完成後授予並穿上遠航造型，再把旅程策劃能力封存為可召回的 Origin Card。"
      },
      "sceneCompositionId": "scene:aozu-club-room",
      "playbook": {
        "initialStageId": "meet-companion",
        "metrics": {
          "planning": 0,
          "bond": 0
        },
        "flags": {
          "origin-card-sealed": false
        },
        "itemDefinitions": [
          {
            "id": "origin-travel-card",
            "name": "旅程策劃 Origin Card",
            "equipSlot": "outfit",
            "defaultAppearance": {
              "packId": "aozu-pudding-otter",
              "packVersion": 1,
              "appearanceId": "outfit-voyage"
            },
            "grants": [
              "travel.plan",
              "travel.recall"
            ]
          }
        ],
        "stages": [
          {
            "id": "meet-companion",
            "title": "和布丁獺相遇",
            "narrative": "先確認這位夥伴，再一起接受第一場旅行建立任務。",
            "agentFallback": true,
            "actions": [
              {
                "id": "start-origin-quest",
                "label": "接受起源任務",
                "phrases": [
                  "接受起源任務",
                  "開始創建我的夥伴"
                ],
                "effects": [
                  {
                    "type": "addMetric",
                    "metricId": "bond",
                    "amount": 1
                  },
                  {
                    "type": "changeStage",
                    "stageId": "plan-first-trip"
                  }
                ]
              }
            ],
            "progress": [
              {
                "id": "bond",
                "label": "羈絆",
                "source": {
                  "fact": "metric",
                  "id": "bond"
                },
                "max": 3
              }
            ]
          },
          {
            "id": "plan-first-trip",
            "title": "告訴我想去的地方",
            "narrative": "把景點、店名或地址貼進對話框；WebMCP 會協助整理。也可以用下方動作逐一確認三個地點。",
            "agentFallback": true,
            "actions": [
              {
                "id": "confirm-place",
                "label": "確認一個地點",
                "phrases": [
                  "確認一個地點",
                  "加入這個地點"
                ],
                "effects": [
                  {
                    "type": "addMetric",
                    "metricId": "planning",
                    "amount": 1
                  }
                ]
              }
            ],
            "progress": [
              {
                "id": "planning",
                "label": "行程完成度",
                "source": {
                  "fact": "metric",
                  "id": "planning"
                },
                "max": 3
              }
            ]
          },
          {
            "id": "claim-reward",
            "title": "遠航造型已穿上",
            "narrative": "布丁獺已真正換成完整遠航造型，旅程策劃能力也已加入角色。現在把這段能力封存起來。",
            "actions": [
              {
                "id": "seal-origin-card",
                "label": "封存 Origin Card",
                "phrases": [
                  "封存 Origin Card",
                  "保存旅程策劃能力"
                ],
                "effects": [
                  {
                    "type": "setFlag",
                    "flagId": "origin-card-sealed",
                    "value": true
                  },
                  {
                    "type": "addMetric",
                    "metricId": "bond",
                    "amount": 2
                  },
                  {
                    "type": "changeStage",
                    "stageId": "origin-card"
                  }
                ]
              }
            ]
          },
          {
            "id": "origin-card",
            "title": "旅程策劃 Origin Card",
            "narrative": "這位夥伴與旅程策劃能力已保存為 Companion。之後可從首頁再次開啟，也能匯出 Bundle 帶走。",
            "terminal": true,
            "actions": []
          }
        ],
        "rules": [
          {
            "ruleId": "complete-first-plan",
            "priority": 100,
            "when": {
              "all": [
                {
                  "fact": "stage",
                  "id": "plan-first-trip"
                },
                {
                  "fact": "metric",
                  "id": "planning",
                  "op": "gte",
                  "value": 3
                }
              ]
            },
            "effects": [
              {
                "type": "grantItem",
                "inventoryId": "origin-travel-card",
                "definitionId": "origin-travel-card",
                "quantity": 1,
                "state": {}
              },
              {
                "type": "equipItem",
                "inventoryId": "origin-travel-card",
                "slot": "outfit"
              },
              {
                "type": "changeStage",
                "stageId": "claim-reward"
              }
            ]
          }
        ]
      }
    }
  ],
  "skeleton": {
    "requiredStageIds": [
      "meet-companion",
      "plan-first-trip",
      "claim-reward",
      "origin-card"
    ],
    "requiredMetricIds": [
      "planning",
      "bond"
    ],
    "instructions": [
      "Keep meet-companion as the initial stage and bind every stage to the AOZU room and selected character.",
      "Use WebMCP dialogue or the local confirm-place action to record three destinations.",
      "Grant and equip origin-travel-card only after planning reaches three.",
      "Keep origin-card terminal so the saved Companion is the reusable ability card."
    ]
  }
}
